<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Retrospective backfill permissions (docs/feature-spec.md §8).

      PACKAGE_USAGE_STATS is a SPECIAL permission: it cannot be requested at runtime. The
      user grants it in Settings → Special app access → Usage access
      (Settings.ACTION_USAGE_ACCESS_SETTINGS); grant state is read via AppOpsManager.
      tools:ignore is required because lint flags it as a signature-level permission.

      READ_CALL_LOG / READ_SMS back AUXILIARY features only (feature-spec §1: never
      backbone). Only the DATE column is ever read — see sensing/CallLogSource.kt.

      NOTE: there is deliberately NO android.permission.INTERNET. Raw sensor streams must
      never leave the device (root CLAUDE.md constraint 4); with no INTERNET permission the
      app is architecturally incapable of egress.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StressDetect">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StressDetect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
