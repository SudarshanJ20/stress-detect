# ── Data & snapshots (never commit participant or derived data) ──────────────
# Ignore the CONTENTS of the data dirs (not the dirs themselves) so the
# .gitkeep placeholders can be re-included below.
ml/data/raw/*
ml/data/processed/*
# Belt-and-braces: data files by extension, anywhere in the tree.
*.parquet
*.csv
*.db
*.sqlite
*.sqlite3

# ── Model binaries ───────────────────────────────────────────────────────────
*.onnx
*.pt
*.pth
*.pkl
*.tflite

# ── Android ──────────────────────────────────────────────────────────────────
.gradle/
build/
*.apk
*.aab
*.keystore
*.jks
local.properties
.cxx/
captures/

# ── Model assets staged into the app (binaries are exported, never committed) ─
# Only the model binary + its reference are ignored. The demo fixture asset IS
# committed: demo mode is a product feature and must work from a clean clone.
android/app/src/main/assets/*.onnx
android/app/src/main/assets/model_reference.json

# ── Throwaway tooling (disposable, never part of the product) ────────────────
tools/device-probe/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store

# ── Keep placeholders & fixtures tracked (MUST come AFTER the ignore rules) ───
# Directory-content ignores above leave the parent dirs un-excluded, so these
# re-includes are valid (git cannot re-include a file under an excluded dir).
!**/.gitkeep
!fixtures/
!fixtures/**
